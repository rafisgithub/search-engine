# Read the documentation before editing:
# https://docs.searxng.org/admin/installation-docker.html
#
# Additional ENVs:
# https://docs.searxng.org/admin/settings/settings_general.html#settings-general
# https://docs.searxng.org/admin/settings/settings_server.html#settings-server

# Pin a specific version instead of "latest" for reproducible deploys,
# e.g. "2026.3.25-541c6c3cb".
#SEARXNG_VERSION=latest

# Listen on a specific address. Set to 127.0.0.1 to keep the instance local.
#SEARXNG_HOST=[::]

# Listen on a specific port.
# 8081, not the 8080 default: the separate SearXNG deployment at
# /home/python/project/searxng already holds 8080 on this machine.
SEARXNG_PORT=8081

# Public URL of the instance. Required when running behind a reverse proxy.
#SEARXNG_BASE_URL=https://search.example.com/
