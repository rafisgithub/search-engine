# OpenSERP — self-hosted SERP scraping API.
# Upstream: https://github.com/karust/openserp
#
#   docker compose up -d
#   curl 'http://localhost:7000/google/search?text=openserp&lang=EN&limit=10'
#
# Engines: /google /yandex /baidu /bing /duckduckgo /ecosia /mega (multi-engine),
# plus /extract and /extract/batch for page content extraction.

services:
  openserp:
    container_name: openserp
    image: karust/openserp:latest
    restart: unless-stopped

    # Reap zombie Chrome processes — this image spawns browsers per request.
    init: true

    # Chrome crashes with "Out of memory" on page loads when /dev/shm is the
    # default 64MB. Prefer an enlarged shm over `ipc: host`, which would give up
    # the container's IPC isolation from the host.
    shm_size: 2gb

    # -l / --leakless: force browser processes to be killed after each search.
    command: serve -l

    ports:
      # Loopback only — OpenSERP has NO authentication. Change to "7000:7000"
      # only behind a reverse proxy or on a trusted network.
      - "127.0.0.1:7000:7000"

    volumes:
      - ./config.yaml:/usr/src/app/config.yaml:ro

    environment:
      # Bind inside the container; the port publish above controls exposure.
      OPENSERP_SERVER_HOST: "0.0.0.0"
      OPENSERP_SERVER_PORT: 7000
      # Baidu blocks aggressively — keep it slower than the other engines.
      OPENSERP_BAIDU_RATE_REQUESTS: 6   # requests per minute
      OPENSERP_BAIDU_RATE_BURST: 2      # burst before the limiter applies

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
